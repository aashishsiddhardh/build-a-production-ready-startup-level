# ── Frontend (Vite) ─────────────────────────────────────────────
# Optional. If unset, the SPA runs fully client-side using the built-in
# deterministic engine + in-browser vector store (the default demo mode).
# Set this to your FastAPI base URL to use the production backend instead.
VITE_API_URL=

# ── Backend (FastAPI) ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ayursage:ayursage@db:5432/ayursage
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# Optional LLM provider for the assistant's natural-language layer.
# Leave empty to use the deterministic, template-based grounded responses.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
