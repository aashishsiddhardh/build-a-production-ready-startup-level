# ─────────────────────────────────────────────────────────────
# AyurSage environment configuration (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Optional: enable the LLM-backed conversational assistant.
# When absent, the assistant runs fully on-device with a grounded,
# retrieval-based responder (no external calls, no keys required).
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: point the client at a real FastAPI backend (reference impl in /backend).
# When absent, the app runs entirely in-browser with local persistence.
VITE_API_BASE_URL=
